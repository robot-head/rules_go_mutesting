load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "runner_lib",
    srcs = [
        "main.go",
        "manifest.go",
        "mutants.go",
        "options.go",
        "session.go",
        "stage.go",
    ],
    importpath = "rules_go_mutesting/mutesting/internal/runner",
    visibility = ["//visibility:private"],
    deps = ["@in_gopkg_yaml_v3//:yaml_v3"],
)

go_binary(
    name = "runner",
    embed = [":runner_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "runner_test",
    srcs = [
        "mutants_test.go",
        "options_test.go",
        "stage_test.go",
    ],
    embed = [":runner_lib"],
)
