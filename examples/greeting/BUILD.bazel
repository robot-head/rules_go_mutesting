load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "greeting",
    srcs = ["greeting.go"],
    importpath = "rules_go_mutesting/examples/greeting",
)

# The test embeds its own golden file, so the go_test's embedsrcs have to be
# staged alongside the library's.
go_test(
    name = "greeting_test",
    srcs = ["greeting_test.go"],
    embed = [":greeting"],
    embedsrcs = ["testdata/greetings.txt"],
)
